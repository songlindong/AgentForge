# 仅用于本机开发，不得用于测试环境或生产环境。
COMPOSE_PROJECT_NAME=agentforge-local

# 宿主机已有 MySQL 5.7 常使用 3306；AgentForge Local 默认避让到 3307。
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=local_mysql_root_not_for_production
MYSQL_DATABASE=agentforge_local
MYSQL_USER=agentforge_local
MYSQL_PASSWORD=local_mysql_app_not_for_production

REDIS_PORT=6379
REDIS_PASSWORD=local_redis_not_for_production

KAFKA_PORT=9092

MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
MINIO_ROOT_USER=agentforge_local
MINIO_ROOT_PASSWORD=local_minio_not_for_production_2026
MILVUS_BUCKET=milvus-local
AGENTFORGE_BUCKET=agentforge-local

OPENSEARCH_PORT=9200

MILVUS_PORT=19530
MILVUS_HEALTH_PORT=19091

# 仅供 Local 内部 API 使用的安全占位映射，不得复用于生产环境。
AGENTFORGE_SERVICE_TOKENS_JSON={"local-knowledge-token":{"tenant_id":"tenant-local","subject":"local-knowledge-operator","scopes":["knowledge:write"]}}
KNOWLEDGE_API_HOST=127.0.0.1
KNOWLEDGE_API_PORT=8087
