{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/contracts/json-schema/knowledge-event.schema.json",
  "title": "AgentForge Multimodal Knowledge Lifecycle Payloads",
  "$defs": {
    "DocumentStageBase": {
      "type": "object",
      "required": [
        "tenant_id", "document_id", "document_version", "job_id", "attempt",
        "trace_id", "source_object_key"
      ],
      "properties": {
        "tenant_id": { "$ref": "./common.schema.json#/$defs/TenantId" },
        "document_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "document_version": { "type": "integer", "minimum": 1 },
        "job_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
        "trace_id": { "$ref": "./common.schema.json#/$defs/TraceId" },
        "source_object_key": {
          "type": "string",
          "description": "内部私有对象键，不得写入普通日志或返回终端用户。",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "DocumentUploadedPayload": {
      "allOf": [
        { "$ref": "#/$defs/DocumentStageBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["media_type", "sha256", "byte_size", "security_scan_status", "uploaded_at"],
          "properties": {
            "tenant_id": true,
            "document_id": true,
            "document_version": true,
            "job_id": true,
            "attempt": true,
            "trace_id": true,
            "source_object_key": true,
            "media_type": { "type": "string", "enum": ["application/pdf", "image/png", "image/jpeg"] },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "byte_size": { "type": "integer", "minimum": 1, "maximum": 104857600 },
            "page_count": { "type": "integer", "minimum": 1 },
            "security_scan_status": { "const": "accepted" },
            "exif_removed": { "type": "boolean" },
            "uploaded_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
          }
        }
      ]
    },
    "Region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "page_number", "bounding_box", "content_type", "artifact_ref"],
      "properties": {
        "region_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "page_number": { "type": "integer", "minimum": 1 },
        "bounding_box": { "$ref": "./file-object.schema.json#/$defs/BoundingBox" },
        "content_type": { "type": "string", "enum": ["text", "title", "list", "table", "figure", "header", "footer"] },
        "artifact_ref": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._:/-]+$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "DocumentParsedPayload": {
      "allOf": [
        { "$ref": "#/$defs/DocumentStageBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["extractor_model_version", "page_count", "regions", "parsed_at"],
          "properties": {
            "tenant_id": true,
            "document_id": true,
            "document_version": true,
            "job_id": true,
            "attempt": true,
            "trace_id": true,
            "source_object_key": true,
            "extractor_model_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
            "page_count": { "type": "integer", "minimum": 1 },
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/Region" }
            },
            "ocr_artifact_ref": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._:/-]+$" },
            "layout_artifact_ref": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._:/-]+$" },
            "table_artifact_ref": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._:/-]+$" },
            "parsed_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
          }
        }
      ]
    },
    "DocumentChunkedPayload": {
      "allOf": [
        { "$ref": "#/$defs/DocumentStageBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["chunk_set_id", "chunker_version", "chunk_count", "chunk_manifest_ref", "chunked_at"],
          "properties": {
            "tenant_id": true,
            "document_id": true,
            "document_version": true,
            "job_id": true,
            "attempt": true,
            "trace_id": true,
            "source_object_key": true,
            "chunk_set_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
            "chunker_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
            "chunk_count": { "type": "integer", "minimum": 1 },
            "chunk_manifest_ref": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._:/-]+$" },
            "chunked_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
          }
        }
      ]
    },
    "EmbeddingRequestedPayload": {
      "allOf": [
        { "$ref": "#/$defs/DocumentStageBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["chunk_set_id", "embedding_model_id", "embedding_model_version", "dimension", "requested_at"],
          "properties": {
            "tenant_id": true,
            "document_id": true,
            "document_version": true,
            "job_id": true,
            "attempt": true,
            "trace_id": true,
            "source_object_key": true,
            "chunk_set_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
            "embedding_model_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
            "embedding_model_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
            "dimension": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "requested_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
          }
        }
      ]
    },
    "KnowledgeVersionPublishedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id", "knowledge_base_id", "knowledge_version", "document_id",
        "document_version", "bm25_index_version", "vector_index_version", "trace_id", "published_at"
      ],
      "properties": {
        "tenant_id": { "$ref": "./common.schema.json#/$defs/TenantId" },
        "knowledge_base_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "knowledge_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
        "document_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "document_version": { "type": "integer", "minimum": 1 },
        "bm25_index_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
        "vector_index_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
        "trace_id": { "$ref": "./common.schema.json#/$defs/TraceId" },
        "published_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
      }
    },
    "EvaluationRequestedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "tenant_id", "dataset_version", "target_version", "requested_by", "trace_id", "requested_at"],
      "properties": {
        "evaluation_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "tenant_id": { "$ref": "./common.schema.json#/$defs/TenantId" },
        "dataset_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
        "target_version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
        "requested_by": { "$ref": "./common.schema.json#/$defs/Actor" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["recall_at_5", "precision_at_5", "mrr", "ndcg_at_10", "citation_accuracy", "groundedness", "hallucination_rate", "refusal_precision", "refusal_recall"]
          }
        },
        "trace_id": { "$ref": "./common.schema.json#/$defs/TraceId" },
        "requested_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/DocumentUploadedPayload" },
    { "$ref": "#/$defs/DocumentParsedPayload" },
    { "$ref": "#/$defs/DocumentChunkedPayload" },
    { "$ref": "#/$defs/EmbeddingRequestedPayload" },
    { "$ref": "#/$defs/KnowledgeVersionPublishedPayload" },
    { "$ref": "#/$defs/EvaluationRequestedPayload" }
  ]
}
