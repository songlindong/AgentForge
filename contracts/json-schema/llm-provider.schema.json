{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/contracts/json-schema/llm-provider.schema.json",
  "title": "AgentForge LLM Provider and OpenAI-Compatible Chat Contract",
  "$ref": "#/$defs/ProviderManifest",
  "$defs": {
    "ProviderManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "version",
        "transport",
        "endpoint_ref",
        "models",
        "timeout_policy",
        "retry_policy",
        "status"
      ],
      "properties": {
        "provider_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "version": { "$ref": "./common.schema.json#/$defs/SemanticVersion" },
        "transport": {
          "type": "string",
          "enum": ["openai_compatible", "ollama", "vllm", "fake"]
        },
        "endpoint_ref": {
          "type": "string",
          "description": "配置或 Secret 引用，不得包含明文密钥。",
          "pattern": "^(config|secret)://[A-Za-z0-9._:/-]+$"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ModelCapability" }
        },
        "timeout_policy": { "$ref": "./common.schema.json#/$defs/TimeoutPolicy" },
        "retry_policy": { "$ref": "./common.schema.json#/$defs/RetryPolicy" },
        "status": { "type": "string", "enum": ["active", "degraded", "disabled"] }
      }
    },
    "ModelCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "modalities",
        "max_context_tokens",
        "max_output_tokens",
        "streaming",
        "tool_calls",
        "json_schema_output"
      ],
      "properties": {
        "model_id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "text" },
          "items": { "type": "string", "enum": ["text", "image", "audio_input", "audio_output"] }
        },
        "max_context_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "streaming": { "type": "boolean" },
        "tool_calls": { "type": "boolean" },
        "json_schema_output": { "type": "boolean" },
        "price_input_per_million_minor_units": { "type": "integer", "minimum": 0 },
        "price_output_per_million_minor_units": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "TextContentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "ImageUrlContentPart": {
      "type": "object",
      "description": "保持 OpenAI image_url 结构，但只允许 AgentForge 内部受控对象 URI。",
      "additionalProperties": false,
      "required": ["type", "image_url"],
      "properties": {
        "type": { "const": "image_url" },
        "image_url": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^agentforge://objects/[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "detail": { "type": "string", "enum": ["auto", "low", "high"] }
          }
        }
      }
    },
    "ChatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
        "name": { "type": "string", "maxLength": 128 },
        "tool_call_id": { "type": "string", "maxLength": 128 },
        "content": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 131072 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/TextContentPart" },
                  { "$ref": "#/$defs/ImageUrlContentPart" }
                ]
              }
            }
          ]
        }
      }
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "function"],
      "properties": {
        "type": { "const": "function" },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "parameters"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
            "description": { "type": "string", "maxLength": 1024 },
            "parameters": { "type": "object" },
            "strict": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "ChatCompletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "messages"],
      "properties": {
        "model": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ChatMessage" }
        },
        "stream": { "type": "boolean", "default": false },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/ToolDefinition" }
        },
        "tool_choice": {
          "oneOf": [
            { "type": "string", "enum": ["none", "auto", "required"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "function"],
              "properties": {
                "type": { "const": "function" },
                "function": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": { "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } }
                }
              }
            }
          ]
        },
        "response_format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["text", "json_object", "json_schema"] },
            "json_schema": { "type": "object" }
          }
        },
        "user": {
          "type": "string",
          "description": "不可逆散列后的终端用户标识，不能传递真实个人信息。",
          "maxLength": 128
        }
      }
    },
    "ToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "function"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "type": { "const": "function" },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "arguments"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
            "arguments": { "type": "string", "description": "JSON 编码的参数；Skill Executor 必须再次按 Schema 校验。" }
          }
        }
      }
    },
    "AssistantMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "const": "assistant" },
        "content": { "type": ["string", "null"] },
        "tool_calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolCall" }
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cost_minor_units": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "ChatCompletionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object", "created", "model", "choices", "usage"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "object": { "const": "chat.completion" },
        "created": { "type": "integer", "minimum": 0 },
        "model": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "message", "finish_reason"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "message": { "$ref": "#/$defs/AssistantMessage" },
              "finish_reason": { "type": ["string", "null"], "enum": ["stop", "length", "tool_calls", "content_filter", null] }
            }
          }
        },
        "usage": { "$ref": "#/$defs/Usage" }
      }
    },
    "ChatCompletionChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object", "created", "model", "choices"],
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "object": { "const": "chat.completion.chunk" },
        "created": { "type": "integer", "minimum": 0 },
        "model": { "$ref": "./common.schema.json#/$defs/Identifier" },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "delta", "finish_reason"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "delta": { "type": "object" },
              "finish_reason": { "type": ["string", "null"], "enum": ["stop", "length", "tool_calls", "content_filter", null] }
            }
          }
        },
        "usage": { "$ref": "#/$defs/Usage" }
      }
    },
    "OpenAIErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "type", "code", "retryable", "trace_id"],
          "properties": {
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "type": {
              "type": "string",
              "enum": ["invalid_request_error", "authentication_error", "permission_error", "rate_limit_error", "server_error", "timeout_error"]
            },
            "param": { "type": ["string", "null"], "maxLength": 256 },
            "code": { "$ref": "./error.schema.json#/$defs/ErrorCode" },
            "retryable": { "type": "boolean" },
            "retry_after_ms": { "type": "integer", "minimum": 0, "maximum": 300000 },
            "trace_id": { "$ref": "./common.schema.json#/$defs/TraceId" }
          }
        }
      }
    }
  }
}
